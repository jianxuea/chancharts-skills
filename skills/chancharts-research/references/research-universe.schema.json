{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RESEARCH_UNIVERSE_INPUT_V1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "source"],
      "properties": {"schema": {"const": "RESEARCH_UNIVERSE_INPUT_V1"}, "source": {"const": "web_watchlist"}}
    },
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "source", "symbols"],
      "properties": {
        "schema": {"const": "RESEARCH_UNIVERSE_INPUT_V1"}, "source": {"const": "explicit_symbols"},
        "symbols": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^[0-9]{6}\\.(SZ|SH|BJ)$"}}
      }
    }
  ]
}
